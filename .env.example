# Copy this file to .env and fill in your real keys.
# Do not commit your real .env.

# -----------------------------------------------------------------------------
# Default stage behavior in deepseek_novel_writer.py
# -----------------------------------------------------------------------------
# - Writer:   volcengine / kimi2.6 by default
# - Review:   deepseek / deepseek-v4-pro by default; recommend a 1M/long-context model if available
# - Revision: volcengine / kimi2.6 by default
#
# Abstract/outline and review agents read the longest context; prefer 1M/long-context models for them.
# You can override providers/models from the CLI, for example:
#   python3 deepseek_novel_writer.py ./outputs/testagent 20 \
#     --writer-provider aliyun \
#     --revision-provider aliyun

# -----------------------------------------------------------------------------
# Volcengine Ark Agent Plan / Kimi
# -----------------------------------------------------------------------------
# Used by writer and revision by default unless overridden.
VOLCENGINE_API_KEY=your_volcengine_ark_api_key
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# 可选模型详见 https://www.volcengine.com/docs/82379/2366394?lang=zh
# 支持 JSON 数组或逗号分隔字符串；Gradio 会用这个列表生成模型下拉框。
VOLCENGINE_MODELS=["deepseek-v4-pro","minimax-m3", "kimi-k2.6"]

# Optional aliases supported by llm_client.py:
# ARK_API_KEY=your_volcengine_ark_api_key
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# ARK_MODELS=["kimi-k2.6"]
# KIMI_API_KEY=your_volcengine_ark_api_key
# KIMI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# KIMI_MODELS=["kimi-k2.6"]

# -----------------------------------------------------------------------------
# Alibaba Cloud Bailian Token Plan
# -----------------------------------------------------------------------------
# Use with: --writer-provider aliyun --revision-provider aliyun
ALIYUN_API_KEY=your_aliyun_bailian_token_plan_key
ALIYUN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 可选模型详见 https://bailian.console.aliyun.com/cn-beijing?tab=doc#/doc/?type=model&url=3028856
# 支持 JSON 数组或逗号分隔字符串；Gradio 会用这个列表生成模型下拉框。
ALIYUN_MODELS=["deepseek-v4-pro", "qwen3.7-max", "kimi-k2.6"]

# Optional aliases supported by llm_client.py:
# ALIYUN_BAILIAN_API_KEY=your_aliyun_bailian_token_plan_key
# ALIYUN_BAILIAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ALIYUN_BAILIAN_MODELS=["kimi-k2.6"]
# BAILIAN_API_KEY=your_aliyun_bailian_token_plan_key
# BAILIAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# BAILIAN_MODELS=["kimi-k2.6"]
# DASHSCOPE_API_KEY=your_aliyun_bailian_token_plan_key
# DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODELS=["kimi-k2.6"]

# -----------------------------------------------------------------------------
# DeepSeek
# -----------------------------------------------------------------------------
# Used by review by default unless overridden.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=["deepseek-v4-pro"]

# -----------------------------------------------------------------------------
# Generic OpenAI-compatible fallback
# -----------------------------------------------------------------------------
# Use with: --provider custom, or as fallback aliases for supported providers.
# LLM_API_KEY=your_generic_api_key
# LLM_BASE_URL=https://your-provider.example.com/v1
# LLM_MODELS=["your-model-name"]
# OPENAI_API_KEY=your_openai_compatible_api_key
# OPENAI_BASE_URL=https://your-provider.example.com/v1
# OPENAI_MODELS=["your-model-name"]
# CUSTOM_API_KEY=your_custom_api_key
# CUSTOM_BASE_URL=https://your-provider.example.com/v1
# CUSTOM_MODELS=["your-model-name"]

# -----------------------------------------------------------------------------
# Stage-specific examples
# -----------------------------------------------------------------------------
# These are CLI flags, not .env variables:
#   outline_agent.py ./outputs/testagent --generate-global --provider aliyun --model kimi-k2.6
#   --writer-provider aliyun --writer-model kimi-k2.6
#   --review-provider aliyun --review-model kimi-k2.6
#   --revision-provider volcengine --revision-model kimi-k2.6
